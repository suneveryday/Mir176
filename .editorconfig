root = true

[*.{md,txt,json,yml,yaml,py,sh,ps1}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[server/**/*.cs]
indent_style = space
indent_size = 4

# Imported Delphi and vendor files preserve their original encoding and bytes.
[client/current-source/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
